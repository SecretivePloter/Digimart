# Private configuration: /etc/lidealabs/app.env, root:lidealabs mode 0640.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# qris_manual uses product price without Midtrans credentials or fees.
PAYMENT_PROVIDER=qris_manual
PAYMENTS_ENABLED=true
MANUAL_QRIS_IMAGE=/var/lib/lidealabs/private/qris-gopay.png
MANUAL_QRIS_MERCHANT="MUGENWORKLABS, PULSA & INTERNET"
MANUAL_PAYMENT_EVIDENCE_DIR=/var/lib/lidealabs/manual-evidence
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=
# Must be confirmed; blank values deliberately disable checkout.
MIDTRANS_FEE_BPS=
MIDTRANS_FEE_FIXED_IDR=
MIDTRANS_PRODUCTION_APPROVED=false
HOST=127.0.0.1
PORT=3000
ADMIN_PUBLIC_ORIGIN=
WA_AUTH_DIR=/var/lib/lidealabs/wa-auth
WA_PAIRING_MODE=false
# Comma-separated buyer AND admin numbers explicitly authorized for tests.
WA_TEST_NUMBERS=
