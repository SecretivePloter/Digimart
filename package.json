{
  "name": "digimart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/*.test.js",
    "db:migrate": "node --env-file=.env.local dist/migrate.js",
    "catalog:import": "node --env-file=.env.local dist/catalog-admin.js import",
    "catalog:inspect": "node --env-file=.env.local dist/catalog-admin.js inspect",
    "order:create": "node --env-file=.env.local dist/order-cli.js create",
    "order:inspect": "node --env-file=.env.local dist/order-cli.js inspect",
    "payment:reconcile": "node --env-file=.env.local dist/order-cli.js reconcile",
    "wa:start": "node --env-file=.env.local dist/whatsapp.js",
    "start": "node --env-file=.env.local dist/server.js",
    "smoke": "node --env-file=.env.local dist/smoke.js",
    "admin:setup": "node --env-file=.env.local dist/admin-setup.js",
    "catalog:import-xlsx": "node --env-file=.env.local dist/catalog-import-xlsx.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "pg": "^8.16.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.9.0"
  }
}
